---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import TagWrapper from "@/components/Wrapper/TagWrapper.astro";
import Button from "@/components/Button.astro";
import Img from "@/components/Media/Img.astro";
import lumos_background from "@/assets/graphics/lumos-background.svg";
import logo_icon from "@/assets/logo/logo-icon.svg";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import Form from "@/components/Form/Form.astro";
import Fieldset from "@/components/Form/Fieldset.astro";
import Input from "@/components/Form/Input.astro";
import Select from "@/components/Form/Select.astro";
import Choice from "@/components/Form/Choice.astro";
import Range from "@/components/Form/Range.astro";
import Textarea from "@/components/Form/Textarea.astro";
import Tabs from "@/components/Interactive/Tabs.astro";
import TabLink from "@/components/Interactive/TabLink.astro";
import Dropdown from "@/components/Interactive/Dropdown.astro";
import Overlay from "@/components/Media/Overlay.astro";
import Modal from "@/components/Interactive/Modal.astro";
import Slider from "@/components/Interactive/Slider.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import Marquee from "@/components/Interactive/Marquee.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import Video from "@/components/Media/Video.astro";
import Icon from "@/components/Media/Icon.astro";
import RichText from "@/components/Typography/RichText.astro";
import arrow from "@/assets/icons/arrow.svg";
import play from "@/assets/icons/play.svg";
import close from "@/assets/icons/close.svg";
import check from "@/assets/icons/check.svg";
import videoTest from "@/assets/graphics/video-test.mp4";
import NavMinimal from "@/components/Global/NavMinimal.astro";

const heading = "We build things that help people work smarter";
const text =
  "We build things that help people work smarter, move faster, and grow further.";
const lorem =
  "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.";
---

<Layout
  title="Example Components"
  description="Every layout variant, side by side."
  theme="dark"
>
  <NavMinimal />
  <!-- cards · media · light -->
  <Section theme="light" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · media · light</Eyebrow>
      <Heading tag="h2" variant="h4">Media cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={3}>
      <Card
        variant="media"
        heading="Build the tools"
        text="Senior talent, custom tools and new workflows."
        image={lumos_background}
        imageAlt=""
      />
      <Card
        variant="media"
        heading="Months become days"
        text="Senior talent, custom tools and new workflows that give ambitious ideas more room to happen."
        image={lumos_background}
        imageAlt=""
      />
      <Card
        variant="media"
        heading="Experience sparks action"
        text="Senior talent, custom tools and carefully designed workflows that give ambitious ideas more room to happen without adding unnecessary complexity."
        image={lumos_background}
        imageAlt=""
      />
    </Grid>
  </Section>

  <!-- cards · media · dark -->
  <Section theme="dark" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · media · dark</Eyebrow>
      <Heading tag="h2" variant="h4">Media cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={3}>
      <Card
        variant="media"
        heading="Build the tools"
        text="Senior talent, custom tools and new workflows."
        image={lumos_background}
        imageAlt=""
      />
      <Card
        variant="media"
        heading="Months become days"
        text="Senior talent, custom tools and new workflows that give ambitious ideas more room to happen."
        image={lumos_background}
        imageAlt=""
      />
      <Card
        variant="media"
        heading="Experience sparks action"
        text="Senior talent, custom tools and carefully designed workflows that give ambitious ideas more room to happen without adding unnecessary complexity."
        image={lumos_background}
        imageAlt=""
      />
    </Grid>
  </Section>

  <!-- cards · service · light -->
  <Section theme="light" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · service · light</Eyebrow>
      <Heading tag="h2" variant="h4">Service cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={3}>
      <Card
        variant="service"
        heading="Fixed project"
        text="A defined scope, an agreed timeline and a fixed fee."
        footer="For launches, redesigns and focused work."
      />
      <Card
        variant="service"
        heading="Dedicated subscription"
        text="An embedded team with design, art direction and project management. We learn your product and move through priorities together."
        footer="For ongoing work that needs a steady rhythm."
      />
      <Card
        variant="service"
        heading="Custom partnership"
        text="A setup shaped around your business: multiple workstreams, specialist expertise or a blend of project work and support."
        footer="Team, responsibilities and commercial terms agreed together."
      />
    </Grid>
  </Section>

  <!-- cards · service · dark -->
  <Section theme="dark" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · service · dark</Eyebrow>
      <Heading tag="h2" variant="h4">Service cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={3}>
      <Card
        variant="service"
        heading="Fixed project"
        text="A defined scope, an agreed timeline and a fixed fee."
        footer="For launches, redesigns and focused work."
      />
      <Card
        variant="service"
        heading="Dedicated subscription"
        text="An embedded team with design, art direction and project management. We learn your product and move through priorities together."
        footer="For ongoing work that needs a steady rhythm."
      />
      <Card
        variant="service"
        heading="Custom partnership"
        text="A setup shaped around your business: multiple workstreams, specialist expertise or a blend of project work and support."
        footer="Team, responsibilities and commercial terms agreed together."
      />
    </Grid>
  </Section>

  <!-- cards · case · light -->
  <Section theme="light" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · case · light</Eyebrow>
      <Heading tag="h2" variant="h4">Case cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={2}>
      <Card
        variant="case"
        heading="Product launch"
        text="A focused identity and digital launch."
        image={lumos_background}
        imageAlt=""
      />
      <Card
        variant="case"
        heading="A flexible brand system"
        text="A connected system spanning strategy, identity and product design for a growing international team."
        image={lumos_background}
        imageAlt=""
      />
    </Grid>
  </Section>

  <!-- cards · case · dark -->
  <Section theme="dark" paddingTop="small" paddingBottom="small" gap="32">
    <ContentWrapper>
      <Eyebrow>card · case · dark</Eyebrow>
      <Heading tag="h2" variant="h4">Case cards</Heading>
    </ContentWrapper>
    <Grid small={2} medium={2}>
      <Card
        variant="case"
        heading="Product launch"
        text="A focused identity and digital launch."
        video={videoTest}
        imageAlt=""
      />
      <Card
        variant="case"
        heading="A flexible brand system"
        text="A connected system spanning strategy, identity and product design for a growing international team. A connected system spanning strategy, identity and product design"
        image={lumos_background}
        imageAlt=""
      />

    </Grid>
  </Section>

  
</Layout>
