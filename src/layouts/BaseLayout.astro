---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";
import SkipLink from "@/components/Global/SkipLink.astro";
import Footer from "@/components/Global/Footer.astro";
import SquareCursor from "@/components/Interactive/SquareCursor.astro";
import PagePreloader from "@/components/Utility/PagePreloader.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark";
};

const { theme = "inherit", ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SquareCursor />
    <PagePreloader />

    <script>
      import { initSmoothScroll } from "@/utils/motion/smoothScroll";

      let cleanupScroll = initSmoothScroll();
      const startScroll = () => {
        cleanupScroll();
        cleanupScroll = initSmoothScroll();
      };
      document.addEventListener("astro:page-load", startScroll);
      const stopScroll = () => cleanupScroll();
      document.addEventListener("astro:before-swap", stopScroll);
      if (import.meta.hot) {
        import.meta.hot.dispose(() => {
          cleanupScroll();
          document.removeEventListener("astro:page-load", startScroll);
          document.removeEventListener("astro:before-swap", stopScroll);
        });
      }
    </script>
    <script>
      import { initMotion } from "@/utils/motion";

      let cleanupMotion = () => {};

      const startMotion = () => {
        cleanupMotion();
        cleanupMotion = initMotion(document);
      };

      startMotion();
      document.addEventListener("astro:page-load", startMotion);
      document.addEventListener("astro:before-swap", () => cleanupMotion());
    </script>
  </body>
</html>
