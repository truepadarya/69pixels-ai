---
import "@/styles/global.css";
import BaseHead from "@/components/Utility/BaseHead.astro";
import SkipLink from "@/components/Global/SkipLink.astro";
import Footer from "@/components/Global/Footer.astro";
import SquareCursor from "@/components/Interactive/SquareCursor.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "dark";
};

const { theme = "inherit", ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
    <style is:inline>
      .page-preloader {
        position: fixed;
        inset: 0;
        z-index: 2147483647;
        background: #000;
        opacity: 1;
        transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .page-preloader.is-hidden {
        opacity: 0;
        pointer-events: none;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-preloader {
          transition: none;
        }
      }
    </style>
    <noscript
      ><style is:inline>
        .page-preloader {
          display: none;
        }
      </style></noscript
    >
  </head>
  <body>
    <SkipLink />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SquareCursor />
    <div class="page-preloader" aria-hidden="true"></div>
    <script>
      const hidePreloader = () => {
        const preloader =
          document.querySelector<HTMLElement>(".page-preloader");
        if (preloader?.classList.contains("is-hidden")) return;

        const revealPage = () => {
          if (
            document.documentElement.classList.contains("is-page-reveal-ready")
          )
            return;
          document.documentElement.classList.add("is-page-reveal-ready");
          document.dispatchEvent(new Event("page:ready"));
        };

        if (preloader) {
          preloader.classList.add("is-hidden");
        }
        revealPage();
        document.documentElement.classList.add("is-page-ready");
      };

      if (document.readyState === "complete") {
        hidePreloader();
      } else {
        window.addEventListener("load", hidePreloader, { once: true });
      }
      document.addEventListener("astro:page-load", hidePreloader);
    </script>
    <script>
      import Lenis from "lenis";
      import "lenis/dist/lenis.css";

      new Lenis({
        autoRaf: true,
        anchors: true,
      });
    </script>
    <script>
      import { initMotion } from "@/utils/motion";

      let cleanupMotion = () => {};

      const startMotion = () => {
        cleanupMotion();
        cleanupMotion = initMotion(document);
      };

      startMotion();
      document.addEventListener("astro:page-load", startMotion);
      document.addEventListener("astro:before-swap", () => cleanupMotion());
    </script>


  </body>
</html>
