---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

type Base = HTMLAttributes<"a"> & {
  /** Set to `false` to skip rendering this component. */
  render?: boolean;
  /** Small line of text above the pricing details. Inline markup is rendered. */
  label: string;
  /** The card's price or pricing title. Inline markup is rendered. */
  heading: string;
  /** Short qualifier displayed beside the heading. Inline markup is rendered. */
  suffix?: string;
  /** Makes a numeric price more prominent than a pricing title. */
  price?: boolean;
  /** Body copy under the heading. Inline markup is rendered. */
  text: string;
};

type Props = Base & (
  | {
      /** How the card is composed: linked pricing or an informational work setup. */
      variant?: "pricing";
      /** Where the card leads. */
      href: string;
    }
  | {
      variant: "setup";
      href?: never;
    }
);

const {
  render = true,
  label,
  heading,
  suffix,
  price = false,
  text,
  variant = "pricing",
  href,
  class: className,
  ...rest
} = Astro.props;

const Tag = variant === "setup" ? "div" : "a";
const hasContent = !!(label && heading && text && (variant === "setup" || href));
---

{
  render && hasContent && (
    <Tag
      class:list={["pricing-card_wrap", variant === "setup" && "setup", price && "price", className]}
      href={href}
      {...rest}
    >
      <Eyebrow class="pricing-card_label">
        <Fragment set:html={label} />
      </Eyebrow>
      <div class="pricing-card_content">
        <div class="pricing-card_heading-row">
          <Heading
            tag="h3"
            variant={price ? "h1" : "h4"}
            class="pricing-card_heading"
          >
            <Fragment set:html={heading} />
          </Heading>
          {suffix && (
            <Paragraph tag="span" variant="main-xl" class="pricing-card_suffix">
              <Fragment set:html={suffix} />
            </Paragraph>
          )}
        </div>
        <Paragraph variant="main-xl" class="pricing-card_text">
          <Fragment set:html={text} />
        </Paragraph>
      </div>
    </Tag>
  )
}

<style is:global>
  @layer components {
    .pricing-card_wrap {
      --_seam-position: 18%;
      --_cutout-size: var(--space-24);
      width: 100%;
      height: auto;
      aspect-ratio: 6 / 7;
      align-self: start;
      padding: var(--space-28);
      padding-bottom: var(--space-32);
      display: flex;
      flex-direction: column;
      position: relative;
      container-type: inline-size;
      background-color: var(--background-2-solid);
      color: var(--text);
      text-decoration: none;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);

      &:not(.setup):is(:hover, :focus-visible) {
        --text: var(--dark-900);
        --text-2: color-mix(in srgb, var(--dark-900) 70%, transparent);
        background-color: color-mix(
          in srgb,
          var(--light-100) 97%,
          var(--dark-900)
        );
      }

      &::before,
      &::after {
        content: "";
        width: var(--_cutout-size);
        aspect-ratio: 1;
        position: absolute;
        z-index: 2;
        top: var(--_seam-position);
        border-radius: 50%;
        background-color: var(--background);
        translate: 0 -50%;
        scale: 0;
        transition: scale 180ms var(--hover-ease);
        pointer-events: none;
      }

      &::before {
        left: calc(var(--_cutout-size) / -2);
      }

      &::after {
        right: calc(var(--_cutout-size) / -2);
      }

      &:not(.setup):is(:hover, :focus-visible)::before,
      &:not(.setup):is(:hover, :focus-visible)::after {
        scale: 1;
      }
    }

    .pricing-card_label {
      letter-spacing: 0.08em;
      text-transform: uppercase;

      &::after {
        content: "";
        position: absolute;
        top: var(--_seam-position);
        right: 0;
        left: 0;
        border-top: 1px dashed
          color-mix(in srgb, var(--dark-900) 56%, transparent);
        opacity: 0;
        scale: 0 1;
        transform-origin: right;
        transition:
          opacity 100ms linear,
          scale 220ms var(--hover-ease);
        pointer-events: none;
      }
    }

    .pricing-card_wrap:not(.setup):is(:hover, :focus-visible) .pricing-card_label::after {
      opacity: 1;
      scale: 1;
    }

    .pricing-card_content {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      gap: var(--space-24);
    }

    .pricing-card_wrap.setup {
      background-color: color-mix(in srgb, var(--dark-900) 3%, transparent);
      transition: none;

      &::before,
      &::after,
      .pricing-card_label::after {
        display: none;
      }

      .pricing-card_label {
        --text-small-font-weight: var(--primary-medium);
        color: var(--text);
        letter-spacing: var(--letter-spacing-small);
        text-transform: none;
      }

      .pricing-card_heading {
        font-size: clamp(1.5rem, 10cqw, var(--h4));
      }

      .pricing-card_text {
        font-size: clamp(1rem, 4.6cqw, var(--text-main-xl));
        color: color-mix(in srgb, var(--text) 60%, transparent);
        transition: none;
      }
    }

    .pricing-card_wrap.price .pricing-card_content {
      gap: var(--space-28);
    }

    .pricing-card_wrap.price .pricing-card_heading {
      min-width: 0;
      font-size: clamp(3.25rem, 13cqw, calc(var(--h1) * 0.74));
      white-space: nowrap;
    }

    .pricing-card_heading-row {
      display: flex;
      align-items: flex-end;
      gap: var(--space-8);
      flex-wrap: nowrap;
    }

    .pricing-card_suffix {
      flex: none;
      white-space: nowrap;
    }

    .pricing-card_text {
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
    }

    @media (width < 48rem) {
      .pricing-card_wrap {
        height: 24rem;
        max-height: none;
        aspect-ratio: auto;
        align-self: stretch;
        padding: var(--space-20);
        padding-bottom: var(--space-24);
      }

      .pricing-card_wrap.price .pricing-card_heading {
        font-size: clamp(3rem, 15cqw, 4.5rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .pricing-card_wrap,
      .pricing-card_wrap::before,
      .pricing-card_wrap::after,
      .pricing-card_label::after,
      .pricing-card_text {
        transition: none;
      }
    }
  }
</style>
