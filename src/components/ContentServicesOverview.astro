---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const services = [
  {
    title: "Brand & Strategy",
    description:
      "Positioning, brand narrative and creative direction that give every expression a clear point of view.",
  },
  {
    title: "Websites & Digital Products",
    description:
      "Strategy, UX, design systems and development for fast, useful digital experiences built to evolve.",
  },
  {
    title: "Creative Production",
    description:
      "Campaigns, motion, 3D and content systems that turn one strong idea into a complete visual world.",
  },
  {
    title: "AI Systems & Automation",
    description:
      "Custom tools, generative workflows and product integrations that make ambitious work happen faster.",
  },
];
---

{
  render && (
    <div class:list={["services-overview_wrap", className]} {...rest}>
      <Heading id="services-overview-title" tag="h2" variant="h3" maxWidth={18}>
        Big-picture thinking.
        <br />
        Full-scale execution.
      </Heading>

      <div class="services-overview_list">
        {services.map((service) => (
          <article class="services-overview_item">
            <Heading tag="h3" variant="h6">
              {service.title}
            </Heading>
            <Paragraph variant="main-xl" maxWidth={54}>
              {service.description}
            </Paragraph>
          </article>
        ))}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .services-overview_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-72);
    }

    .services-overview_list {
      width: 100%;
    }

    .services-overview_item {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--site-gutter);
      align-items: start;
      min-height: calc(var(--space-96) + var(--space-8));
      padding-block: var(--space-48);
    }

    .services-overview_item:not(:last-child) {
      border-bottom: var(--border-width) solid var(--border);
    }

    .services-overview_item > .heading {
      font-weight: var(--primary-semibold);
    }

    .services-overview_item > .text {
      color: var(--text-2);
    }

    @media (width < 48rem) {
      .services-overview_wrap {
        gap: var(--space-64);
      }

      .services-overview_item {
        grid-template-columns: 1fr;
        gap: var(--space-16);
        min-height: 0;
        padding-block: var(--space-48);
      }
    }
  }
</style>
