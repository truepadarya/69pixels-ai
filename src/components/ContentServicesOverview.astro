---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import { getImage } from "astro:assets";
import { serviceCursorGalleries } from "@/data/serviceCursorGalleries";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

// Keep the gallery setup available, without rendering hover zones or loading previews.
const cursorGalleriesEnabled = false;

const services = [
  {
    title: "AI Automation",
    gallery: serviceCursorGalleries.ai,
    bullets: [
      "Automate recurring tasks",
      "Build custom tools for your team",
      "Create visuals at scale",
      "Speed up design and development",
      "Add AI to your product",
    ],
    terms: "T&M, Subscription",
  },
  {
    title: "Brand Foundations",
    gallery: serviceCursorGalleries.brand,
    description: "When ambition outgrows identity.",
    terms: "Fixed Price, T&M",
  },
  {
    title: "MVP Launch",
    gallery: serviceCursorGalleries.digital,
    description: "From idea to product-market signal.",
    terms: "T&M, Subscription",
  },
  {
    title: "Product Evolution",
    gallery: serviceCursorGalleries.digital,
    description: "When the product needs to grow up.",
    terms: "T&M, Subscription",
  },
  {
    title: "Ongoing Design",
    gallery: serviceCursorGalleries.creative,
    description: "Continuous taste, clarity, and execution.",
    terms: "T&M, Subscription",
  },
  {
    title: "Development Partnership",
    gallery: serviceCursorGalleries.digital,
    description: "Long-term product and tech collaboration.",
    terms: "T&M, Subscription",
  },
  {
    title: "Discovery & Strategy",
    gallery: serviceCursorGalleries.brand,
    description: "Before anything is built.",
    terms: "Fixed Price, T&M",
  },
];

const previews = cursorGalleriesEnabled
  ? await Promise.all(
      services.map(async (service) =>
        Promise.all(
          service.gallery.map(async (src) => {
            const image = await getImage({
              src,
              width: Math.min(src.width, 720),
              format: "webp",
              quality: 75,
            });
            return { src: image.src };
          }),
        ),
      ),
    )
  : [];
---

{
  render && (
    <div
      class:list={["services-overview_wrap", className]}
      data-services-overview
      {...rest}
    >
      <ContentWrapper
        centered
        class="services-overview_intro"
        column1Class="services-overview_intro-content"
      >
        <Heading
          id="services-overview-title"
          tag="h2"
          variant="h3"
          class="services-overview_heading"
        >
          Choose the way in
        </Heading>
        <Paragraph variant="main-xl" class="services-overview_subheading">
          Six engagements. Where we enter, what we resolve
        </Paragraph>
      </ContentWrapper>

      <div class="services-overview_list">
        {services.map((service, index) => (
          <article class="services-overview_item">
            <Heading tag="h3" variant="h6">
              {service.title}
            </Heading>
            <div class="services-overview_details">
              {service.bullets ? (
                <ul
                  class="services-overview_bullets text-style-main-xl"
                  role="list"
                >
                  {service.bullets.map((bullet) => (
                    <li class="services-overview_bullet">{bullet}</li>
                  ))}
                </ul>
              ) : (
                <Paragraph
                  variant="main-xl"
                  class="services-overview_description"
                >
                  {service.description}
                </Paragraph>
              )}
              {service.terms && (
                <Paragraph variant="mono" class="services-overview_terms">
                  {service.terms.split(", ").map((term, termIndex) => (
                    <>
                      {termIndex > 0 && ", "}
                      <a
                        class="services-overview_term-link"
                        data-anchor-focus={
                          term === "Fixed Price" ? "fixed-project" : undefined
                        }
                        href={
                          term === "Subscription"
                            ? "#dedicated-subscription"
                            : "#project-partnership"
                        }
                      >
                        {term}
                      </a>
                    </>
                  ))}
                </Paragraph>
              )}
            </div>
            {cursorGalleriesEnabled && (
              <span
                class="services-overview_hover text-style-main-xl"
                data-cursor-gallery={JSON.stringify(previews[index])}
                data-cursor-desktop
                aria-hidden="true"
              />
            )}
          </article>
        ))}
      </div>
    </div>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { mountScrollScene } from "@/utils/motion/scrollScene";

  gsap.registerPlugin(ScrollTrigger);

  mountScrollScene("[data-services-overview]", (root) => {
    const media = gsap.matchMedia();
    media.add(
      "(prefers-reduced-motion: no-preference) and (width >= 64rem) and (pointer: fine)",
      () => {
        const items = root.querySelectorAll<HTMLElement>(
          ".services-overview_intro, .services-overview_item",
        );
        const timeline = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: root,
            start: "top 80%",
            end: "bottom 85%",
            scrub: true,
            invalidateOnRefresh: true,
          },
        });

        gsap.set(items, { autoAlpha: 0, y: "var(--reveal-distance-main)" });
        timeline.to(items, { autoAlpha: 1, y: 0, duration: 1, stagger: 1 });
      },
    );
    return () => media.revert();
  });
</script>

<style is:global>
  @layer components {
    .services-overview_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-72);
    }

    .services-overview_list {
      width: min(100%, 64rem);
      margin-inline: auto;
    }

    .services-overview_heading {
      align-self: center;
      width: 100%;
      text-align: center;
    }

    .services-overview_heading-line {
      display: block;
    }

    .services-overview_intro.layout > .services-overview_intro-content {
      gap: var(--space-32);
    }

    .services-overview_subheading,
    .services-overview_details {
      color: var(--text-2);
    }

    .services-overview_details {
      display: contents;
      min-width: 0;
    }

    .services-overview_terms {
      justify-self: end;
      text-align: right;
      color: var(--text-2);
    }

    .services-overview_term-link {
      color: inherit;
      text-decoration: none;

      @media (width < 64rem), (pointer: coarse) {
        display: inline-flex;
        align-items: center;
        min-height: 2.75rem;
      }

      &:is(:hover, :focus-visible) {
        color: var(--text);
      }
    }

    .services-overview_bullets {
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .services-overview_bullet {
      display: flex;
      align-items: baseline;
      gap: 0.75em;

      &::before {
        content: "";
        flex: 0 0 0.35em;
        width: 0.35em;
        height: 0.35em;
        background: currentColor;
        transform: translateY(-0.15em);
      }
    }

    .services-overview_item {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 24rem) minmax(0, 0.8fr);
      gap: var(--site-gutter);
      align-items: start;
      min-height: calc(var(--space-96) + var(--space-8));
      padding-block: var(--space-48);
    }

    .services-overview_hover {
      position: absolute;
      inset-block: 0;
      left: 0;
      right: max(0rem, calc((100% - var(--site-gutter)) * 7 / 12 - 54ch));
      z-index: 1;

      @media (width < 64rem) {
        display: none;
      }
    }

    .services-overview_item:not(:last-child) {
      border-bottom: var(--border-width) solid var(--border);
    }

    .services-overview_item > .heading {
      font-weight: var(--primary-semibold);
    }

    .services-overview_wrap {
      @media (width < 64rem) {
        :where(&) .services-overview_item {
          grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        }

        :where(&) .services-overview_details {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: var(--space-16);
        }

        :where(&) .services-overview_terms {
          text-align: left;
        }
      }

      @media (width < 48rem) {
        & {
          gap: var(--space-64);
        }

        :where(&) .services-overview_item {
          grid-template-columns: 1fr;
          gap: var(--space-16);
          min-height: 0;
          padding-block: var(--space-48);
        }
      }
    }
  }
</style>
