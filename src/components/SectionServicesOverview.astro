---
import type { ComponentProps } from "astro/types";
import Section from "@/components/Wrapper/Section.astro";
import ContentServicesOverview from "@/components/ContentServicesOverview.astro";

type Props = Pick<
  ComponentProps<typeof Section>,
  "render" | "paddingTop" | "paddingBottom"
>;

const {
  render = true,
  paddingTop = "large",
  paddingBottom = "large",
} = Astro.props;
---

{
  render && (
    <Section
      theme="light"
      paddingTop={paddingTop}
      paddingBottom={paddingBottom}
      gap="0"
      class="services-overview-section_wrap"
      containerClass="services-overview-section_content"
      aria-labelledby="services-overview-title"
    >
      <ContentServicesOverview />
    </Section>
  )
}

<style is:global>
  @layer components {
    .services-overview-section_wrap {
      --background: color-mix(in srgb, var(--light-100) 97%, var(--dark-900));
      --section-space-large: clamp(6rem, 11.5vw, 12rem);
      position: relative;
      z-index: 100;
      isolation: isolate;
      min-height: 100svh;
      margin-top: -100svh;
      justify-content: flex-start;
      border: 0;

      @media (prefers-reduced-motion: reduce) {
        margin-top: 0;
      }

      @media (width < 48rem) {
        --section-space-large: 9rem;

        & .services-overview-section_content {
          width: var(--site-width);
        }
        & .services-overview-section_content .services-overview_item > .text {
          max-width: 54ch;
        }
      }
    }
    .services-overview-section_content {
      z-index: 1;
      width: min(96%, var(--max-width-main));
    }
    .services-overview-section_content .services-overview_item > .text {
      max-width: 54ch;
    }
    .services-overview-section_content .services-overview_item {
      padding-block: var(--space-40);
    }
  }
</style>
