---
interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Additional CSS classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
const source =
  "https://player.vimeo.com/video/1054848178?badge=0&autopause=0&player_id=0&app_id=58479&loop=1&muted=1&autoplay=1";
---

{
  render && (
    <div
      class:list={["lynq-film_wrap", className]}
      data-lynq-film
      data-cursor-native
    >
      <iframe
        class="lynq-film_player"
        src={source}
        title="LYNQ - Meaningful. Local. Connections."
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
      />
    </div>
  )
}

<style is:global>
  @layer components {
    .lynq-film_wrap {
      position: relative;
      width: 100%;
      height: 100%;
      aspect-ratio: 16 / 9;
      overflow: clip;
      background: #0d0d0d;
    }
    .lynq-film_player {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      border: 0;
    }
  }
</style>
