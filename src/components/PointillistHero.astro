---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const pointillistPath = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/pointillist`;

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <Fragment>
      <div
        class:list={["pointillist_wrap", className]}
        aria-hidden="true"
        {...rest}
      >
        <img
          class="pointillist_background"
          src={`${pointillistPath}/background.webp`}
          alt=""
          width="2048"
          height="1231"
        />
        <picture>
          <source
            media="(width < 48rem)"
            srcset={`${pointillistPath}/silhouette-mobile.webp`}
            type="image/webp"
          />
          <source
            srcset={`${pointillistPath}/silhouette.webp`}
            type="image/webp"
          />
          <source
            media="(width < 48rem)"
            srcset={`${pointillistPath}/silhouette-mobile.svg`}
          />
          <img
            class="pointillist_original"
            src={`${pointillistPath}/silhouette.svg`}
            alt=""
            width="2048"
            height="1231"
          />
        </picture>
      </div>
      <script is:inline src={`${pointillistPath}/turn.js`} defer />
    </Fragment>
  )
}

<style is:global>
  @layer components {
    .pointillist_wrap {
      position: absolute;
      inset: 0;
      isolation: isolate;
      overflow: hidden;
      background: var(--dark-700);
    }
    .pointillist_wrap::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 2;
      background: rgb(0 0 0 / 10%);
      pointer-events: none;
    }
    .pointillist_wrap img,
    .pointillist_wrap canvas {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      user-select: none;
      pointer-events: none;
    }
    .pointillist_original,
    .pointillist_light {
      z-index: 1;
      image-rendering: pixelated;
    }
    .pointillist_wrap {
      @media (width < 48rem) {
        --hero-face-scale: 1.15;
        --hero-face-y: -10%;
        & .pointillist_original,
        & .pointillist_light {
          transform: translateY(var(--hero-face-y))
            scale(var(--hero-face-scale));
          transform-origin: center top;
        }
      }
    }

    .hero_wrap:is(.centered, .editorial) .pointillist_wrap {
      @media (width >= 48rem) {
        & .pointillist_original,
        & .pointillist_light {
          transform: scale(1.06, 1.12);
          transform-origin: center top;
        }
      }
    }
  }
</style>
