---
import type { HTMLAttributes } from "astro/types";
import CardPricing from "@/components/Item/CardPricing.astro";
import Heading from "@/components/Typography/Heading.astro";
import Grid from "@/components/Wrapper/Grid.astro";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const cards = [
  {
    label: "Fixed project",
    heading: "For launches, redesigns and projects with a clear finish line.",
    text: "A defined scope, an agreed timeline and a fixed fee. We take ownership of delivery from kickoff to handoff.",
  },
  {
    label: "Dedicated subscription",
    heading: "For ongoing work. Scale the team as your needs grow.",
    text: "An embedded team with design, art direction and project management. We learn your product and move through priorities together.",
  },
  {
    label: "Custom partnership",
    heading: "We agree on the team, responsibilities and commercial terms together.",
    text: "A setup shaped around your business. Multiple workstreams, specialist expertise or a blend of project work and ongoing support.",
  },
];
---

{
  render && (
    <div
      class:list={["work-setup_wrap", className]}
      data-work-setup
      {...rest}
    >
      <Heading
        id="work-setup-title"
        tag="h2"
        variant="h2"
        class="section-heading-primary work-setup_heading"
      >
        Your ambition.
        <br />
        The right setup.
      </Heading>

      <Grid class="work-setup_layout">
        {cards.map((card) => (
          <CardPricing
            class="work-setup_card"
            variant="setup"
            label={card.label}
            heading={card.heading}
            text={card.text}
          />
        ))}
      </Grid>
    </div>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { mountScrollScene } from "@/utils/motion/scrollScene";

  gsap.registerPlugin(ScrollTrigger);

  mountScrollScene("[data-work-setup]", (root) => {
    const media = gsap.matchMedia();
    media.add("(prefers-reduced-motion: no-preference)", () => {
      const items = root.querySelectorAll<HTMLElement>(
        ".work-setup_heading, .work-setup_card",
      );
      const timeline = gsap.timeline({
        defaults: { ease: "none" },
        scrollTrigger: {
          trigger: root,
          start: "top 80%",
          end: "bottom 85%",
          scrub: true,
          invalidateOnRefresh: true,
        },
      });

      gsap.set(items, { autoAlpha: 0, y: "var(--reveal-distance-main)" });
      timeline.to(items, { autoAlpha: 1, y: 0, duration: 1, stagger: 1 });
    });
    return () => media.revert();
  });
</script>

<style is:global>
  @layer components {
    .work-setup_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      margin-top: var(--space-24);
      gap: var(--space-88);
    }

    .work-setup_layout.grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: start;
      gap: var(--space-16);

      @media (width < 64rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));

        > :last-child:nth-child(odd) {
          grid-column: 1 / -1;
        }
      }

      @media (width < 48rem) {
        grid-template-columns: 1fr;
      }
    }

    .work-setup_heading {
      align-self: center;
    }

  }
</style>
