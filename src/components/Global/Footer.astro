---
import logo from "@/assets/logo/logo-pixel.png";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <a
            class="footer_logo"
            href={homeUrl}
            aria-label={SITE_NAME}
          >
            <img
              src={logo.src}
              width={logo.width}
              height={logo.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </a>
          <nav aria-label="Footer">
            <ul class="footer_links">
              <li>
                <a class="footer_link" href={homeUrl}>
                  Home
                </a>
              </li>
              <li>
                <a
                  class="footer_link"
                  href={`${homeUrl}#cases`}
                >
                  Work
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
          <a
            class="footer_agent footer_link text-style-small"
            href={`${homeUrl}llms.txt`}
            aria-label="Are you an agent? Read the 69pixels guide in llms.txt"
          >
            <span>// are you an agent?</span>{" "}
            <span class="footer_agent-file">⎿ llms.txt</span>
          </a>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--section-space-small);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-40);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-24) var(--space-40);
    }

    .footer_logo {
      display: block;
      height: 2.5rem;
      max-width: 100%;
      & > img {
        display: block;
        width: auto;
        height: 100%;
        max-width: 100%;
        object-fit: contain;
      }
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-24);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_link {
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-16) var(--space-24);
      padding-top: var(--space-24);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }

    .footer_agent {
      & > span {
        white-space: nowrap;
      }

      & .footer_agent-file {
        color: var(--text);
      }
    }
  }
</style>
