---
import logo from "@/assets/logo/logo-pixel.png";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
const homeUrl = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <div class="footer_brand">
            <a class="footer_logo" href={homeUrl} aria-label={SITE_NAME}>
              <img
                src={logo.src}
                width={logo.width}
                height={logo.height}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </a>
          </div>
          <nav aria-label="Footer">
            <ul class="footer_links">
              <li>
                <a class="footer_link" href={homeUrl}>
                  Home
                </a>
              </li>
              <li>
                <a class="footer_link" href={`${homeUrl}#cases-centered`}>
                  Work
                </a>
              </li>
              <li>
                <a class="footer_link" href="mailto:hello@69pixels.com">
                  Contact ↗
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="footer_bottom">
          <div class="footer_details">
            <p class="footer_copyright">
              &copy; <span id="year">{new Date().getFullYear()}</span>{" "}
              {SITE_NAME}
            </p>
            <dl class="footer_metadata">
              <div class="footer_fact">
                <>
                  <dt>built</dt>
                  <dd>with AI</dd>
                </>
              </div>
              <div class="footer_fact">
                <>
                  <dt>edited</dt>
                  <dd>by {SITE_NAME}</dd>
                </>
              </div>
              <div class="footer_fact">
                <>
                  <dt>status</dt>
                  <dd>fully editable</dd>
                </>
              </div>
              <div class="footer_fact">
                <dt>for agents</dt>
                <dd>
                  <a
                    class="footer_agent footer_link"
                    href={`${homeUrl}llms.txt`}
                    aria-label="Are you an agent? Read the 69pixels guide in llms.txt"
                  >
                    llms.txt ↗
                  </a>
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-block: var(--space-32);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      font-family: var(--text-mono-font-family);
      font-size: var(--text-small);
      line-height: var(--text-mono-line-height);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-32);
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-24) var(--space-40);
    }

    .footer_brand {
      display: flex;
      align-items: center;
      gap: var(--space-24);
    }

    .footer_logo {
      display: block;
      height: 2rem;
      max-width: 100%;
      & > img {
        display: block;
        width: auto;
        height: 100%;
        max-width: 100%;
        object-fit: contain;
      }
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-24);
      font-family: var(--text-mono-font-family);
      font-size: var(--text-small);
      font-weight: var(--primary-regular);
      list-style: none;
      padding: 0;
    }

    .footer_link {
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      width: 100%;
    }

    .footer_copyright {
      color: var(--text-2);

      &::before,
      &::after {
        content: none;
      }
    }

    .footer_details {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-24);
      color: var(--text);
    }

    .footer_metadata {
      display: contents;
    }

    .footer_fact {
      display: flex;
      align-items: baseline;
      gap: 0.6em;
      white-space: nowrap;

      dt {
        color: var(--text-2);
      }

      dd {
        color: inherit;
        margin: 0;
      }
    }

    .footer_agent {
      color: inherit;
      &:is(:hover, :focus-visible) {
        color: var(--brand-500);
      }
    }

    .footer_wrap {
      @media (width < 64rem), (pointer: coarse) {
        .footer_link,
        .footer_logo {
          display: inline-flex;
          align-items: center;
          min-height: 2.75rem;
        }
        .footer_logo > img {
          height: 2rem;
        }
      }
      @media (width < 64rem) {
        .footer_details {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          gap: var(--space-24) var(--space-16);
        }

        .footer_copyright {
          grid-column: 1 / -1;
          order: 1;
        }
      }
      @media (width < 30rem) {
        .footer_details {
          grid-template-columns: 1fr;
        }
        .footer_top {
          align-items: flex-start;
          flex-direction: column;
        }
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .footer_logo,
      .footer_link {
        transition: none;
      }
    }
  }
</style>
