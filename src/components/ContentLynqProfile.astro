---
import Img from "@/components/Media/Img.astro";
import full from "@/assets/graphics/cases/lynq-profile/full.png";
import screen from "@/assets/graphics/cases/lynq-profile/screen.png";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Additional CSS classes. */
  class?: string;
}
const { render = true, class: className } = Astro.props;
---

{
  render && (
    <div class:list={["lynq-profile_wrap", className]} data-lynq-profile>
      <div class="lynq-profile_phone">
        <div
          class="lynq-profile_viewport"
          role="img"
          aria-label="LYNQ member profile: Stephanie's portfolio, circles, events and personal details, shown in a scrolling phone preview."
        >
          <div class="lynq-profile_content" data-profile-content>
            <Img
              src={full}
              alt=""
              variant="constrained"
              sizes="(min-width: 64rem) 24vw, 12rem"
              transparent
              loading="eager"
              class="lynq-profile_image full"
              aria-hidden="true"
            />
          </div>
          <div class="lynq-profile_navigation" aria-hidden="true">
            <Img
              src={screen}
              alt=""
              variant="constrained"
              sizes="(min-width: 64rem) 24vw, 12rem"
              transparent
              loading="eager"
              class="lynq-profile_image navigation"
              aria-hidden="true"
            />
          </div>
        </div>
      </div>
      <button
        type="button"
        class="lynq-profile_control"
        data-profile-control
        aria-label="Pause profile preview"
        aria-pressed="false"
      >
        Ⅱ
      </button>
    </div>
  )
}

<style is:global>
  @layer components {
    .lynq-profile_wrap {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      justify-content: center;
      background: #0d0d0d;
      @media (prefers-reduced-motion: reduce) {
        & .lynq-profile_control {
          display: none;
        }
      }
    }
    .lynq-profile_phone {
      position: relative;
      height: 100%;
      aspect-ratio: 390 / 841;
      flex: none;
      container-type: inline-size;
    }
    .lynq-profile_viewport {
      position: absolute;
      inset: 0;
      overflow: clip;
      border-radius: 12.3077cqw;
      background: black;
    }
    .lynq-profile_content {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 520.7692cqw;
      background: black;
    }
    .lynq-profile_image {
      position: absolute;
      left: 0;
      display: block;
      width: 100%;
      height: auto;
      &.full {
        top: 0;
      }
      &.navigation {
        bottom: 0;
        clip-path: inset(calc(100% - 21.0256cqw) 0 0);
      }
    }
    .lynq-profile_navigation {
      position: absolute;
      inset: auto 0 0;
      height: 37.4359cqw;
      overflow: clip;
      background: linear-gradient(
        to bottom,
        transparent,
        black 43.8356%,
        black
      );
      pointer-events: none;
    }
    .lynq-profile_control {
      position: absolute;
      bottom: 0.5rem;
      right: 0.5rem;
      display: grid;
      place-items: center;
      width: 1.75rem;
      height: 1.75rem;
      border: 0;
      border-radius: 0;
      padding: 0;
      background: var(--dark-825);
      color: var(--gray-300);
      font-size: 0.75rem;
      line-height: 1;
      cursor: pointer;
      opacity: 0;
    }
    .lynq-profile_wrap:hover .lynq-profile_control,
    .lynq-profile_control:focus-visible {
      opacity: 1;
    }
    .lynq-profile_control:focus-visible {
      outline: var(--focus-width) solid var(--gray-400);
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { mountScrollScene } from "@/utils/motion/scrollScene";

  mountScrollScene("[data-lynq-profile]", (root) => {
    const viewport = root.querySelector<HTMLElement>(".lynq-profile_viewport");
    const content = root.querySelector<HTMLElement>("[data-profile-content]");
    const control = root.querySelector<HTMLButtonElement>(
      "[data-profile-control]",
    );
    if (!viewport || !content || !control) return;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const travel = () =>
      Math.max(0, content.offsetHeight - viewport.clientHeight);
    const timeline = gsap
      .timeline({ paused: true, repeat: -1, repeatDelay: 1.5 })
      .fromTo(
        content,
        { y: 0 },
        { y: () => -travel(), duration: 8, ease: "power1.inOut" },
        0.7,
      )
      .fromTo(
        content,
        { y: () => -travel() },
        { y: 0, duration: 6.5, ease: "power1.inOut", immediateRender: false },
        10.1,
      );
    let visible = false;
    let ready = false;
    let paused = false;
    let disposed = false;
    const synchronize = () => {
      if (reduced.matches) timeline.pause(0);
      else if (ready && visible && !paused && !document.hidden && !disposed)
        timeline.play();
      else timeline.pause();
      control.textContent = paused ? "▶" : "Ⅱ";
      control.setAttribute(
        "aria-label",
        paused ? "Play profile preview" : "Pause profile preview",
      );
      control.setAttribute("aria-pressed", String(paused));
    };
    const observer = new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting && entry.intersectionRatio >= 0.25;
        synchronize();
      },
      { threshold: [0, 0.25] },
    );
    observer.observe(viewport);
    const resize = new ResizeObserver(() => {
      const time = timeline.totalTime();
      timeline.invalidate().totalTime(time);
    });
    resize.observe(viewport);
    const onControl = () => {
      paused = !paused;
      synchronize();
    };
    control.addEventListener("click", onControl);
    document.addEventListener("visibilitychange", synchronize);
    reduced.addEventListener("change", synchronize);
    void Promise.all(
      Array.from(root.querySelectorAll("img"), (image) =>
        image.decode().catch(() => {}),
      ),
    ).then(() => {
      if (disposed) return;
      ready = true;
      synchronize();
    });
    synchronize();
    return () => {
      disposed = true;
      observer.disconnect();
      resize.disconnect();
      timeline.kill();
      control.removeEventListener("click", onControl);
      document.removeEventListener("visibilitychange", synchronize);
      reduced.removeEventListener("change", synchronize);
    };
  });
</script>
