---
import Heading from "@/components/Typography/Heading.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  context: string;
  title: string;
  timeline: string;
  before: string;
  after: string;
  facts: Array<{ label: string; value: string; detail: string }>;
  note: string;
  class?: string;
}
const {
  render = true,
  context,
  title,
  timeline,
  before,
  after,
  facts,
  note,
  class: className,
} = Astro.props;
---

{
  render && (
    <div class:list={["case-results_wrap", className]}>
      <div class="case-results_content">
        <span class="case-results_context">{context}</span>
        <Heading tag="h4" variant="inherit" class="case-results_title">
          {title}
        </Heading>
        <dl class="case-results_list">
          <div class="case-results_row">
            <dt class="case-results_label">{timeline}</dt>
            <dd class="case-results_comparison">
              <span class="case-results_before">{before}</span>
              <span class="case-results_arrow" aria-label="to">
                →
              </span>
              <strong class="case-results_after">{after}</strong>
            </dd>
          </div>
          {facts.map((fact) => (
            <div class="case-results_row">
              <dt class="case-results_label">{fact.label}</dt>
              <dd class="case-results_fact">
                <strong class="case-results_number">{fact.value}</strong>
                <span class="case-results_detail">{fact.detail}</span>
              </dd>
            </div>
          ))}
        </dl>
        <p class="case-results_note">{note}</p>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    .case-results_wrap {
      width: 100%;
      height: 100%;
      container-type: inline-size;
      aspect-ratio: 0.92;
      background: var(--dark-825);
      color: var(--light-100);
      text-align: left;
    }
    .case-results_content {
      height: 100%;
      display: flex;
      flex-direction: column;
      padding: 6cqw;
    }
    .case-results_context {
      font-size: max(0.75rem, 2.6cqw);
      line-height: 1.2;
      font-weight: var(--primary-medium);
    }
    .case-results_title {
      margin: 4cqw 0 5cqw;
      font-size: 6.1cqw;
      font-weight: var(--primary-medium);
      line-height: 1.04;
      letter-spacing: var(--letter-spacing-small);
      text-wrap: balance;
    }
    .case-results_list {
      margin: 0;
    }
    .case-results_row {
      padding-block: 3.2cqw;
      border-top: var(--border-width) solid var(--dark-700);
    }
    .case-results_label {
      font-size: max(0.75rem, 2.8cqw);
      line-height: 1.3;
      color: var(--gray-400);
    }
    .case-results_comparison {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: baseline;
      gap: 2.5cqw;
      margin: 1.2cqw 0 0;
      font-size: 6.5cqw;
      line-height: 1.1;
      letter-spacing: var(--letter-spacing-small);
      white-space: nowrap;
    }
    .case-results_before {
      color: var(--gray-500);
    }
    .case-results_arrow {
      color: var(--gray-600);
      font-size: 4cqw;
    }
    .case-results_after {
      color: var(--brand-500);
      text-align: right;
      font-size: 7.5cqw;
      font-weight: var(--primary-medium);
    }
    .case-results_fact {
      display: flex;
      align-items: baseline;
      gap: 3cqw;
      margin: 0.75cqw 0 0;
    }
    .case-results_number {
      font-size: 6.5cqw;
      line-height: 1.1;
      font-weight: var(--primary-medium);
      letter-spacing: var(--letter-spacing-small);
    }
    .case-results_detail {
      font-size: max(0.75rem, 2.8cqw);
      color: var(--gray-400);
    }
    .case-results_note {
      margin: auto 0 0;
      padding-top: 3cqw;
      color: var(--gray-400);
      font-size: max(0.75rem, 2.6cqw);
      line-height: 1.4;
    }
    .case-results_note::before,
    .case-results_note::after {
      content: none;
    }
    @container (width < 22rem) {
      .case-results_title {
        margin-block: 3cqw 4cqw;
      }
      .case-results_row {
        padding-block: 2cqw;
      }
      .case-results_label,
      .case-results_detail {
        font-size: max(0.6875rem, 2.8cqw);
      }
      .case-results_note {
        font-size: 0.6875rem;
        line-height: 1.35;
      }
    }
  }
</style>
