---
import type { ComponentProps } from "astro/types";
import Section from "@/components/Wrapper/Section.astro";
import ContentWorkSetup from "@/components/ContentWorkSetup.astro";

type Props = Pick<ComponentProps<typeof Section>, "render">;

const { render = true } = Astro.props;
---

<Section
  render={render}
  theme="light"
  gap="0"
  class="work-setup-section_wrap"
  containerClass="work-setup-section_content"
  aria-labelledby="work-setup-title"
>
  <ContentWorkSetup />
</Section>

<style is:global>
  @layer components {
    .work-setup-section_wrap {
      --background: color-mix(in srgb, var(--light-100) 97%, var(--dark-900));
      position: relative;
      z-index: 2;
      isolation: isolate;
      justify-content: flex-start;
      padding-top: 0;
      padding-bottom: clamp(8rem, 11vw, 13rem);
      border: 0;

      @media (width < 48rem) {
        padding-bottom: 7rem;
        & .work-setup-section_content {
          width: var(--site-width);
        }
      }
    }
    .work-setup-section_content {
      width: min(96%, var(--max-width-main));
      z-index: 1;
    }
  }
</style>
