---
import type { ComponentProps } from "astro/types";
import Section from "@/components/Wrapper/Section.astro";
import ContentWorkSetup from "@/components/ContentWorkSetup.astro";

type Props = Pick<ComponentProps<typeof Section>, "render">;

const { render = true } = Astro.props;
---

<Section
  render={render}
  theme="light"
  paddingBottom="large"
  gap="0"
  class="work-setup-section_wrap"
  aria-labelledby="work-setup-title"
>
  <ContentWorkSetup />
</Section>

<style is:global>
  @layer components {
    .work-setup-section_wrap {
      --background: color-mix(in srgb, var(--light-100) 97%, var(--dark-900));
      position: relative;
      z-index: 2;
      min-height: 100svh;
      padding-top: 0;
      border: 0;

      @media (width < 64rem) {
        padding-top: var(--space-64);
      }
    }
  }
</style>
