---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /**
   * How the tint is distributed.
   *
   * - `solid` — even across the whole area (default)
   * - `gradient` — clear at the top, darkening towards the bottom
   */
  variant?: "solid" | "gradient";
  /**
   * How dark the tint is, as a percentage of the variant's full strength.
   *
   * @min 0
   * @max 100
   * @int
   */
  strength?: number;
}

const {
  render = true,
  variant = "solid",
  strength = 50,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && (
    <div
      class:list={["overlay", variant !== "solid" && variant, className]}
      style={`--_strength: ${strength};`}
      {...rest}
    />
  )
}

<style is:global>
  @layer components {
    .overlay {
      --_background: color-mix(
        in srgb,
        var(--overlay-color) calc(var(--_strength, 50) / 100 * 80%),
        transparent
      );
      --_gradient-background: color-mix(
        in srgb,
        var(--overlay-color) calc(var(--_strength, 50) / 100 * 60%),
        transparent
      );
      --_gradient-end: color-mix(
        in srgb,
        var(--overlay-color) calc(var(--_strength, 50) / 100 * 62%),
        transparent
      );
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      background-color: var(--_background);

      &.gradient {
        background-color: var(--_gradient-background);
        background-image: linear-gradient(
          to bottom,
          transparent,
          var(--_gradient-end) 84%
        );
      }
    }
  }
</style>
