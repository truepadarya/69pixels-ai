const desktopWidth = (card: Card) => {
  if (card.id === "visual-guy") return 18;
  if (card.id === "visual-girl") return 27;
  if (card.id === "visual-logo") return 32;
  const width = card.id === "visual-qualle" ? 18 : card.width;
  const scale =
    card.id === "visual-03" || card.id === "visual-qualle" ? 1.1 : 1;
  return width * (1.12 + (width - 14) * 0.01) * scale;
};

const cardStyle = (card: Card) =>
  [
    `--_x:${card.x}`,
    `--_width:${card.width}`,
    `--_desktop-width:${desktopWidth(card)}`,
    `--_mobile-x:${card.mobileX ?? card.x}`,
    `--_mobile-width:${card.mobileWidth ?? card.width}`,
    ...(card.kind === "placeholder"
      ? [`--_placeholder-ratio:${card.ratio}`]
      : []),
  ].join(";");

const imageSizes = (card: Card) => {
  const mobileWidth = Math.min((card.mobileWidth ?? card.width) * 2.25, 88);
  const tabletWidth = Math.min(card.width * 1.75, 76);

  return `(width < 48rem) ${mobileWidth}vw, (width < 64rem) ${tabletWidth}vw, ${desktopWidth(card)}vw`;
};

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <section
      class:list={["capabilities_wrap", className]}
      data-capabilities
      aria-label="Capabilities"
      {...rest}
    >
      <div class="capabilities_stage">
        {themes.map((theme) => (
          <article
            class="capabilities_theme"
            data-capabilities-theme={theme.id}
          >
            <div class="capabilities_title">
              <Heading tag="h2" variant="h2">
                {theme.title}
              </Heading>
            </div>
            {theme.id === "visual" && (
              <div class="capabilities_title" data-capabilities-branding>
                <Heading tag="h2" variant="h2">
                  Branding & Identity
                </Heading>
              </div>
            )}
            {theme.id === "product" &&
              ["Digital Products", "Design to Development"].map((title) => (
                <div class="capabilities_title" data-capabilities-extra-title>
                  <Heading tag="h2" variant="h2">
                    {title}
                  </Heading>
                </div>
              ))}
            <div class="capabilities_media" aria-hidden="true">
              {theme.cards.map((card) => (
                <div
                  class="capabilities_card"
                  data-card-id={card.id}
                  data-cursor-label={card.label}
                  data-kind={card.kind}
                  data-depth={card.depth ?? "near"}
                  data-hide-mobile={card.hideMobile ? "true" : undefined}
                  data-entry={card.entry}
                  data-duration={card.duration}
                  data-drift={card.drift}
                  data-mobile-entry={card.mobileEntry}
                  data-desktop-entry={card.desktopEntry}
                  data-mobile-entry-offset={card.mobileEntryOffset}
                  data-mobile-y-offset={card.mobileYOffset}
                  data-mobile-scroll-y={card.mobileScrollY}
                  data-mobile-scroll-at={card.mobileScrollAt}
                  data-mobile-scroll-speed={card.mobileScrollSpeed}
                  style={cardStyle(card)}
                >
                  <div class="capabilities_surface">
                    {card.kind === "image" ? (
                      <Img
                        src={card.src}
                        alt=""
                        variant="constrained"
                        sizes={imageSizes(card)}
                      />
                    ) : card.kind === "video" ? (
                      card.ratio ? (
                        <Video
                          src={card.src}
                          variant="custom"
                          ratio={card.ratio}
                          preload="metadata"
                        />
                      ) : (
                        <Video
                          src={card.src}
                          variant="auto"
                          preload="metadata"
                        />
                      )
                    ) : (
                      <div class="capabilities_placeholder" />
                    )}
                  </div>
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const MOBILE_MEDIA_QUERY = "(width < 48rem)";
  const THEME_TOTAL = 2;
  const VISUAL_THEME_INDEX = 0;
  const PRODUCT_THEME_INDEX = 1;
  const MOBILE_VISUAL_ANCHOR_PROGRESS = 0.4;
  const DESKTOP_SCROLL_SCALE = 0.875;
  const DESKTOP_SCROLL_REMOVED = 1 - DESKTOP_SCROLL_SCALE;
  const DESKTOP_VISUAL_END = 0.39;

  const clampProgress = (value: number) => gsap.utils.clamp(0, 1, value);
  const smoothstep = (value: number) => value * value * (3 - 2 * value);
  const readNumber = (element: HTMLElement, key: string) =>
    Number(element.dataset[key] ?? 0);
  const viewportExitOpacity = (
    top: number,
    height: number,
    viewportHeight: number,
  ) => {
    const fadeStart = viewportHeight * 0.025;
    const fadeEnd = -height * 0.9;

    return clampProgress((top - fadeEnd) / (fadeStart - fadeEnd));
  };

  const initCapabilities = (root: HTMLElement) => {
    const stage = root.querySelector<HTMLElement>(".capabilities_stage");
    const mediaViewport = root.querySelector<HTMLElement>(
      ".capabilities_media",
    );
    const themes = gsap.utils.toArray<HTMLElement>(
      "[data-capabilities-theme]",
      root,
    );
    const titles = themes.flatMap((theme) =>
      gsap.utils.toArray<HTMLElement>(".capabilities_title", theme),
    );
    const visualHeading = titles[0]?.querySelector<HTMLElement>(".heading");
    const cards = themes.map((theme) =>
      gsap.utils.toArray<HTMLElement>(".capabilities_card", theme),
    );
    const visualMediaCount = cards[0].findIndex(
      (card) => card.dataset.cardId === "visual-01",
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const isMobile = window.matchMedia(MOBILE_MEDIA_QUERY).matches;
    const isDesktop = window.matchMedia("(width >= 64rem)").matches;

    if (
      prefersReducedMotion.matches ||
      themes.length !== THEME_TOTAL ||
      visualMediaCount < 2 ||
      !stage ||
      !mediaViewport ||
      !visualHeading ||
      titles.some((title) => !title)
    )
      return;

    root.dataset.enhanced = "true";

    const flowEndProgress = parseFloat(
      getComputedStyle(root).getPropertyValue("--capabilities-flow-end"),
    );

    const compactStart = isDesktop ? 0.33 : 0.42;
    const compactScale = 0.82;
    const physicalFlowEnd =
      compactStart + (flowEndProgress - compactStart) * compactScale;
    const toPhysicalProgress = (progress: number) =>
      progress <= compactStart
        ? progress
        : compactStart + (progress - compactStart) * compactScale;

    const scrollDistance = () =>
      Math.max(root.offsetHeight - stage.clientHeight, 0);

    const themeOpacity = (themeIndex: number, progress: number) => {
      const transitionAt =
        themeIndex === 0
          ? isDesktop
            ? DESKTOP_VISUAL_END
            : 0.5
          : isDesktop
            ? 0.79 - DESKTOP_SCROLL_REMOVED
            : isMobile
              ? 0.7
              : 0.79;
      if (themeIndex === PRODUCT_THEME_INDEX) return 1;
      if (progress <= transitionAt - 0.03) return 1;

      return gsap.utils.interpolate(
        1,
        0.4,
        clampProgress((progress - transitionAt + 0.03) / 0.03),
      );
    };

    gsap.set(titles, { autoAlpha: 0, yPercent: 0, filter: "blur(0rem)" });
    gsap.set(titles[0], { autoAlpha: 1, yPercent: 0, filter: "blur(0rem)" });
    gsap.set(visualHeading, { opacity: 0, y: 12 });
    const setHeadingOpacity = gsap.quickSetter(visualHeading, "opacity");
    const setHeadingY = gsap.quickSetter(visualHeading, "y", "px");

    const flowCards = cards.flatMap((group, themeIndex) =>
      group.map((element, cardIndex) => {
        const media =
          element.querySelector<HTMLElement>(".capabilities_surface") ??
          element;
        const explicitMobileEntry = element.dataset.mobileEntry;

        gsap.set(element, { autoAlpha: 1 });
        gsap.set(media, { opacity: 1 });

        return {
          element,
          media,
          themeIndex,
          cardIndex,
          entry: readNumber(element, "entry"),
          desktopEntry:
            element.dataset.desktopEntry === undefined
              ? null
              : readNumber(element, "desktopEntry"),
          mobileEntry: explicitMobileEntry
            ? readNumber(element, "mobileEntry")
            : themeIndex === VISUAL_THEME_INDEX
              ? gsap.utils.interpolate(
                  -0.11,
                  0.4,
                  cardIndex / (visualMediaCount - 1),
                ) + readNumber(element, "mobileEntryOffset")
              : null,
          duration: readNumber(element, "duration"),
          drift: readNumber(element, "drift"),
          mobileYOffset: readNumber(element, "mobileYOffset"),
          mobileScrollY:
            element.dataset.mobileScrollY === undefined
              ? null
              : readNumber(element, "mobileScrollY"),
          mobileScrollAt:
            element.dataset.mobileScrollAt === undefined
              ? MOBILE_VISUAL_ANCHOR_PROGRESS
              : readNumber(element, "mobileScrollAt"),
          mobileScrollSpeed:
            element.dataset.mobileScrollSpeed === undefined
              ? 1
              : readNumber(element, "mobileScrollSpeed"),
          setX: gsap.quickSetter(element, "xPercent"),
          setY: gsap.quickSetter(element, "y", "px"),
          setOpacity: gsap.quickSetter(media, "opacity"),
          setRevealOpacity: gsap.quickSetter(element, "opacity"),
        };
      }),
    );
    const introDepthCards = ["visual-01", "visual-02"].map((id) =>
      flowCards.find(({ element }) => element.dataset.cardId === id),
    );

    const renderIntro = (progress: number) => {
      const reveal = (start: number, end: number) =>
        smoothstep(clampProgress((progress - start) / (end - start)));
      const headingReveal = reveal(isMobile ? 0.72 : 0.68, isMobile ? 1 : 0.96);
      setHeadingOpacity(headingReveal);
      setHeadingY((1 - headingReveal) * 12);
      flowCards[0].setRevealOpacity(reveal(0, isMobile ? 0.4 : 0.36));
      flowCards[1].setRevealOpacity(reveal(isMobile ? 0.68 : 0.64, 1));
      introDepthCards[0]?.setRevealOpacity(reveal(0.43, 0.82));
      introDepthCards[1]?.setRevealOpacity(reveal(0.62, 1));
    };

    const renderFlow = (progress: number) => {
      progress *= physicalFlowEnd;
      if (progress > compactStart)
        progress = compactStart + (progress - compactStart) / compactScale;
      const viewportHeight = mediaViewport.clientHeight;
      const travelDistance = isMobile ? scrollDistance() / physicalFlowEnd : 0;
      const timelineProgress =
        progress * (isDesktop ? DESKTOP_SCROLL_SCALE : 1);
      let visualBottom = 0;
      let productTop = viewportHeight * 1.12;
      let hasVisibleVisual = false;
      const productPositions: Array<{
        setY: (value: number) => void;
        setOpacity: (value: number) => void;
        y: number;
        height: number;
      }> = [];

      flowCards.forEach(
        ({
          element,
          media,
          themeIndex,
          cardIndex,
          entry,
          desktopEntry,
          mobileEntry,
          duration,
          drift,
          mobileYOffset,
          mobileScrollY,
          mobileScrollAt,
          mobileScrollSpeed,
          setX,
          setY,
          setOpacity,
        }) => {
          const originalEntry =
            isMobile && mobileEntry !== null
              ? mobileEntry
              : isDesktop && desktopEntry !== null
                ? desktopEntry
                : entry;
          const resolvedEntry = isDesktop
            ? themeIndex === VISUAL_THEME_INDEX
              ? originalEntry * 0.7
              : originalEntry - DESKTOP_SCROLL_REMOVED
            : originalEntry;
          const resolvedDuration =
            isDesktop && themeIndex === VISUAL_THEME_INDEX
              ? Math.min(duration * 0.85, DESKTOP_VISUAL_END - resolvedEntry)
              : duration;
          const departureProgress =
            isDesktop && themeIndex === VISUAL_THEME_INDEX && cardIndex < 10
              ? smoothstep(clampProgress((timelineProgress - 0.27) / 0.055)) *
                0.2
              : 0;
          const unclampedProgress =
            (timelineProgress - resolvedEntry) / resolvedDuration;
          const rawLocalProgress =
            isDesktop &&
            themeIndex === PRODUCT_THEME_INDEX &&
            unclampedProgress < 0
              ? unclampedProgress
              : gsap.utils.interpolate(
                  clampProgress(
                    (timelineProgress - resolvedEntry) / resolvedDuration,
                  ),
                  1,
                  departureProgress,
                );
          const localProgress =
            rawLocalProgress < 0
              ? rawLocalProgress * 1.3
              : rawLocalProgress +
                (Math.sin(Math.PI * rawLocalProgress) / Math.PI) * 0.3;
          const startY = viewportHeight * 1.12;
          const mediaHeight = media.offsetHeight || element.offsetHeight;
          const endY = -mediaHeight - viewportHeight * 0.14;
          let y =
            isMobile && mobileScrollY !== null
              ? viewportHeight * mobileScrollY -
                (progress - mobileScrollAt) * travelDistance * mobileScrollSpeed
              : gsap.utils.interpolate(startY, endY, localProgress) +
                (isMobile ? viewportHeight * mobileYOffset : 0);
          const exitOpacity = viewportExitOpacity(
            y,
            mediaHeight,
            viewportHeight,
          );

          setX(
            gsap.utils.interpolate(
              drift * -0.35,
              drift,
              Math.max(0, localProgress),
            ),
          );
          setY(y);
          setOpacity(themeOpacity(themeIndex, timelineProgress) * exitOpacity);
          if (
            isDesktop &&
            themeIndex === VISUAL_THEME_INDEX &&
            exitOpacity > 0.01 &&
            y < viewportHeight
          ) {
            hasVisibleVisual = true;
            visualBottom = Math.max(visualBottom, y + mediaHeight);
          }
          if (themeIndex === PRODUCT_THEME_INDEX) {
            productTop = Math.min(productTop, y);
            productPositions.push({
              setY: (value) => setY(value),
              setOpacity: (value) => setOpacity(value),
              y,
              height: mediaHeight,
            });
          }
        },
      );
      if (isDesktop) {
        const enter = smoothstep(clampProgress((progress - 0.33) / 0.04));
        const leave = 1 - smoothstep(clampProgress((progress - 0.5) / 0.12));
        const desiredShift = viewportHeight * 0.55 * enter * leave;
        const safeShift = hasVisibleVisual
          ? Math.max(0, productTop - visualBottom - viewportHeight * 0.055)
          : desiredShift;
        const shift = Math.min(desiredShift, safeShift);
        productPositions.forEach(({ setY, setOpacity, y, height }) => {
          setY(y - shift);
          setOpacity(viewportExitOpacity(y - shift, height, viewportHeight));
        });
      }
    };

    const introTrigger = ScrollTrigger.create({
      trigger: root,
      start: "top 70%",
      end: "top top",
      invalidateOnRefresh: true,
      onUpdate: ({ progress }) => renderIntro(progress),
      onRefresh: ({ progress }) => renderIntro(progress),
    });

    const flowTrigger = ScrollTrigger.create({
      trigger: root,
      start: "top top",
      end: () => `+=${scrollDistance()}`,
      invalidateOnRefresh: true,
      onUpdate: ({ progress }) => renderFlow(progress),
      onRefresh: ({ progress }) => renderFlow(progress),
    });

    renderIntro(introTrigger.progress);
    renderFlow(flowTrigger.progress);

    const titleTimeline = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: root,
        start: "top top",
        end: () => `+=${scrollDistance()}`,
        scrub: 0.25,
        invalidateOnRefresh: true,
      },
    });

    const titleInterval = 1 / titles.length;
    const transitionDuration = 0.025;
    titles.slice(1).forEach((title, index) => {
      const start =
        toPhysicalProgress((index + 1) * titleInterval * flowEndProgress) /
          physicalFlowEnd -
        transitionDuration / 2;
      titleTimeline.to(
        titles[index],
        { autoAlpha: 0, duration: transitionDuration * 0.4 },
        start,
      );
      titleTimeline.to(
        title,
        { autoAlpha: 1, duration: transitionDuration * 0.6 },
        start + transitionDuration * 0.4,
      );
    });
    titleTimeline.to({}, { duration: titleInterval }, 1 - titleInterval);
    const setStageOpacity = gsap.quickSetter(stage, "opacity");
    const renderViewportExit = ({ progress }: { progress: number }) => {
      setStageOpacity(1 - smoothstep(progress));
    };
    const exitTrigger = ScrollTrigger.create({
      trigger: root,
      start: "bottom 145%",
      end: "bottom 115%",
      invalidateOnRefresh: true,
      onEnter: renderViewportExit,
      onUpdate: renderViewportExit,
      onLeave: renderViewportExit,
      onLeaveBack: () => {
        setStageOpacity(1);
        renderFlow(flowTrigger.progress);
      },
      onRefresh: renderViewportExit,
    });
    renderViewportExit(exitTrigger);

    let isActive = true;
    const refresh = () => ScrollTrigger.refresh();
    void document.fonts.ready.then(() => isActive && refresh());
    window.addEventListener("load", refresh, { once: true });

    return () => {
      isActive = false;
      window.removeEventListener("load", refresh);
      flowTrigger.kill();
      introTrigger.kill();
      exitTrigger.kill();
      gsap.set(stage, { clearProps: "opacity" });
      titleTimeline.scrollTrigger?.kill();
      titleTimeline.kill();
    };
  };

  const roots = gsap.utils.toArray<HTMLElement>("[data-capabilities]");
  const mount = () =>
    roots
      .map(initCapabilities)
      .filter((cleanup): cleanup is () => void => Boolean(cleanup));
  let cleanups = mount();
  let resizeFrame = 0;
  const breakpoints = [
    window.matchMedia(MOBILE_MEDIA_QUERY),
    window.matchMedia("(width >= 64rem)"),
  ];
  const onBreakpointChange = () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(() => {
      cleanups.forEach((cleanup) => cleanup());
      cleanups = mount();
      ScrollTrigger.refresh();
    });
  };
  breakpoints.forEach((query) =>
    query.addEventListener("change", onBreakpointChange),
  );

  document.addEventListener(
    "astro:before-swap",
    () => {
      cancelAnimationFrame(resizeFrame);
      breakpoints.forEach((query) =>
        query.removeEventListener("change", onBreakpointChange),
      );
      cleanups.forEach((cleanup) => cleanup());
    },
    { once: true },
  );
</script>

