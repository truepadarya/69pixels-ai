const cardStyle = (card: Card) =>
  [
    `--_x:${card.x}`,
    `--_width:${card.width}`,
    `--_mobile-x:${card.mobileX ?? card.x}`,
    `--_mobile-width:${card.mobileWidth ?? card.width}`,
  ].join(";");

const imageSizes = (card: Card) => {
  const mobileWidth = Math.min((card.mobileWidth ?? card.width) * 2.25, 88);
  const tabletWidth = Math.min(card.width * 1.75, 76);

  return `(width < 48rem) ${mobileWidth}vw, (width < 64rem) ${tabletWidth}vw, ${card.width}vw`;
};

const { render = true, class: className, ...rest } = Astro.props;
---

{
  render && (
    <section
      class:list={["capabilities_wrap", className]}
      data-capabilities
      aria-label="Capabilities"
      {...rest}
    >
      <div class="capabilities_stage">
        {themes.map((theme) => (
          <article
            class="capabilities_theme"
            data-capabilities-theme={theme.id}
          >
            <div class="capabilities_title">
              <Heading tag="h2" variant="h2">
                {theme.title}
              </Heading>
            </div>
            <div class="capabilities_media" aria-hidden="true">
              {theme.cards.map((card) => (
                <div
                  class="capabilities_card"
                  data-entry={card.entry}
                  data-duration={card.duration}
                  data-drift={card.drift}
                  data-mobile-entry={card.mobileEntry}
                  data-mobile-entry-offset={card.mobileEntryOffset}
                  style={cardStyle(card)}
                >
                  {card.kind === "image" ? (
                    <Img
                      src={card.src}
                      alt=""
                      variant="constrained"
                      sizes={imageSizes(card)}
                    />
                  ) : (
                    <Video
                      src={card.src}
                      variant="custom"
                      ratio={card.ratio}
                      preload="metadata"
                    />
                  )}
                </div>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const MOBILE_MEDIA_QUERY = "(width < 48rem)";
  const THEME_TOTAL = 3;
  const VISUAL_THEME_INDEX = 0;
  const RAPID_THEME_INDEX = 2;

  const clampProgress = (value: number) => gsap.utils.clamp(0, 1, value);
  const smoothstep = (value: number) => value * value * (3 - 2 * value);
  const readNumber = (element: HTMLElement, key: string) =>
    Number(element.dataset[key] ?? 0);
  const viewportExitOpacity = (top: number, height: number) => {
    const fadeStart = window.innerHeight * 0.025;
    const fadeEnd = -height * 0.9;

    return clampProgress((top - fadeEnd) / (fadeStart - fadeEnd));
  };

  const initCapabilities = (root: HTMLElement) => {
    const themes = gsap.utils.toArray<HTMLElement>(
      "[data-capabilities-theme]",
      root,
    );
    const titles = themes.map((theme) =>
      theme.querySelector<HTMLElement>(".capabilities_title"),
    );
    const cards = themes.map((theme) =>
      gsap.utils.toArray<HTMLElement>(".capabilities_card", theme),
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    );
    const isMobile = window.matchMedia(MOBILE_MEDIA_QUERY).matches;

    if (
      prefersReducedMotion.matches ||
      themes.length !== THEME_TOTAL ||
      titles.some((title) => !title)
    )
      return;

    root.dataset.enhanced = "true";

    const themeOpacity = (themeIndex: number, progress: number) => {
      const transitionAt = themeIndex === 0 ? 0.5 : isMobile ? 0.7 : 0.79;
      if (themeIndex === RAPID_THEME_INDEX) return 1;
      if (progress <= transitionAt - 0.03) return 1;

      return gsap.utils.interpolate(
        1,
        0.4,
        clampProgress((progress - transitionAt + 0.03) / 0.03),
      );
    };

    gsap.set(titles, { autoAlpha: 0, yPercent: 30, filter: "blur(0.25rem)" });
    gsap.set(titles[0], { autoAlpha: 1, yPercent: 0, filter: "blur(0rem)" });

    const flowCards = cards.flatMap((group, themeIndex) =>
      group.map((element, cardIndex) => {
        const media =
          element.querySelector<HTMLElement>(
            ":scope > .image, :scope > .video",
          ) ?? element;
        const explicitMobileEntry = element.dataset.mobileEntry;

        gsap.set(element, { autoAlpha: 1 });
        gsap.set(media, { opacity: 1 });

        return {
          element,
          media,
          themeIndex,
          cardIndex,
          entry: readNumber(element, "entry"),
          mobileEntry: explicitMobileEntry
            ? readNumber(element, "mobileEntry")
            : themeIndex === VISUAL_THEME_INDEX
              ? gsap.utils.interpolate(
                  -0.11,
                  0.4,
                  cardIndex / (group.length - 1),
                ) + readNumber(element, "mobileEntryOffset")
              : null,
          duration: readNumber(element, "duration"),
          drift: readNumber(element, "drift"),
          setX: gsap.quickSetter(element, "xPercent"),
          setY: gsap.quickSetter(element, "y", "px"),
          setOpacity: gsap.quickSetter(media, "opacity"),
        };
      }),
    );

    const renderFlow = (progress: number) => {
      flowCards.forEach(
        ({
          element,
          media,
          themeIndex,
          cardIndex,
          entry,
          mobileEntry,
          duration,
          drift,
          setX,
          setY,
          setOpacity,
        }) => {
          const resolvedEntry =
            isMobile && mobileEntry !== null ? mobileEntry : entry;
          const rawLocalProgress = clampProgress(
            (progress - resolvedEntry) / duration,
          );
          const localProgress =
            rawLocalProgress +
            (Math.sin(Math.PI * rawLocalProgress) / Math.PI) * 0.3;
          const entranceProgress = clampProgress(
            (progress - cardIndex * 0.018) / 0.045,
          );
          const entranceOpacity =
            isMobile && themeIndex === VISUAL_THEME_INDEX && cardIndex < 2
              ? smoothstep(entranceProgress)
              : 1;
          const startY = window.innerHeight * 1.12;
          const mediaHeight = media.offsetHeight || element.offsetHeight;
          const endY = -mediaHeight - window.innerHeight * 0.14;
          const y = gsap.utils.interpolate(startY, endY, localProgress);
          const exitOpacity = viewportExitOpacity(y, mediaHeight);

          setX(gsap.utils.interpolate(drift * -0.35, drift, localProgress));
          setY(y);
          setOpacity(
            themeOpacity(themeIndex, progress) * exitOpacity * entranceOpacity,
          );
        },
      );
    };

    const flowTrigger = ScrollTrigger.create({
      trigger: root,
      start: "top top",
      end: "bottom bottom",
      invalidateOnRefresh: true,
      onUpdate: ({ progress }) => renderFlow(progress),
      onRefresh: ({ progress }) => renderFlow(progress),
    });

    renderFlow(flowTrigger.progress);

    const titleTimeline = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: root,
        start: "top top",
        end: "bottom bottom",
        scrub: 0.45,
        invalidateOnRefresh: true,
      },
    });

    titleTimeline.to(
      titles[0],
      { autoAlpha: 0, yPercent: -18, filter: "blur(0.18rem)", duration: 0.04 },
      0.48,
    );
    titleTimeline.to(
      titles[1],
      { autoAlpha: 1, yPercent: 0, filter: "blur(0rem)", duration: 0.05 },
      0.5,
    );
    titleTimeline.to(
      titles[1],
      { autoAlpha: 0, yPercent: -18, filter: "blur(0.18rem)", duration: 0.04 },
      isMobile ? 0.68 : 0.77,
    );
    titleTimeline.to(
      titles[2],
      { autoAlpha: 1, yPercent: 0, filter: "blur(0rem)", duration: 0.05 },
      isMobile ? 0.7 : 0.79,
    );
    titleTimeline.to(
      {},
      { duration: isMobile ? 0.3 : 0.21 },
      isMobile ? 0.7 : 0.79,
    );

    const rapidCards = flowCards.filter(
      ({ themeIndex }) => themeIndex === RAPID_THEME_INDEX,
    );
    const rapidTitle = titles[2]!;
    const setRapidTitleOpacity = gsap.quickSetter(rapidTitle, "opacity");

    const renderViewportExit = () => {
      rapidCards.forEach(({ element, media, setOpacity }) => {
        const top = element.getBoundingClientRect().top;
        const height = media.offsetHeight || element.offsetHeight;
        setOpacity(viewportExitOpacity(top, height));
      });

      const titleRect = rapidTitle.getBoundingClientRect();
      setRapidTitleOpacity(
        viewportExitOpacity(titleRect.top, titleRect.height),
      );
    };
    const exitTrigger = ScrollTrigger.create({
      trigger: root,
      start: "bottom bottom",
      end: "bottom top",
      invalidateOnRefresh: true,
      onEnter: renderViewportExit,
      onUpdate: renderViewportExit,
      onLeave: renderViewportExit,
      onLeaveBack: () => {
        setRapidTitleOpacity(1);
        renderFlow(flowTrigger.progress);
      },
    });

    let isActive = true;
    const refresh = () => ScrollTrigger.refresh();
    void document.fonts.ready.then(() => isActive && refresh());
    window.addEventListener("load", refresh, { once: true });

    return () => {
      isActive = false;
      window.removeEventListener("load", refresh);
      flowTrigger.kill();
      exitTrigger.kill();
      titleTimeline.scrollTrigger?.kill();
      titleTimeline.kill();
    };
  };

  const cleanups = gsap.utils
    .toArray<HTMLElement>("[data-capabilities]")
    .map(initCapabilities)
    .filter((cleanup): cleanup is () => void => Boolean(cleanup));

  document.addEventListener(
    "astro:before-swap",
    () => cleanups.forEach((cleanup) => cleanup()),
    { once: true },
  );
</script>

<style is:global>
  @layer components {
    .capabilities_wrap {
      height: 1100svh;
      position: relative;
      background: var(--dark-900);
      color: var(--light-100);
    }

    .capabilities_stage {
      height: 100svh;
      position: sticky;
      top: 0;
      overflow: clip;
      isolation: isolate;
      container-type: inline-size;
    }

    .capabilities_theme,
    .capabilities_media {
      position: absolute;
      inset: 0;
    }

    .capabilities_title {
      width: min(88%, 70rem);
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 2;
      translate: -50% -50%;
      text-align: center;
      pointer-events: none;

      & > .heading {
        font-size: clamp(3rem, 5.1cqw, 5rem);
        line-height: var(--line-height-compact);
        text-wrap: balance;
      }
    }

    .capabilities_wrap:not([data-enhanced="true"])
      .capabilities_theme:not(:first-child) {
      display: none;
    }

    .capabilities_card {
      width: calc(var(--_width) * 1%);
      position: absolute;
      top: 0;
      left: calc(var(--_x) * 1%);
      overflow: hidden;
      pointer-events: none;
      will-change: transform, opacity;

      & > :is(.image, .video) {
        width: 100%;
        height: auto;
        display: block;
        object-fit: cover;
      }
    }

    @media (width < 64rem) {
      .capabilities_title {
        width: calc(100% - var(--site-margin) * 2);

        & > .heading {
          font-size: clamp(2.75rem, 8.5cqw, 4.75rem);
        }
      }

      .capabilities_card {
        width: min(calc(var(--_width) * 1.75%), 76%);
      }
    }

    @media (width < 48rem) {
      .capabilities_card {
        width: min(calc(var(--_mobile-width) * 2.25%), 88%);
        left: calc(var(--_mobile-x) * 1%);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .capabilities_wrap {
        height: auto;
      }

      .capabilities_stage {
        height: auto;
        position: relative;
        overflow: hidden;
      }

      .capabilities_theme,
      .capabilities_wrap:not([data-enhanced="true"])
        .capabilities_theme:not(:first-child) {
        display: block;
        min-height: 100svh;
        position: relative;
        padding: var(--section-space-medium) var(--site-margin);
      }

      .capabilities_title {
        width: 100%;
        position: relative;
        top: auto;
        left: auto;
        translate: none;
        margin-bottom: var(--space-64);
      }

      .capabilities_media {
        position: relative;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--site-gutter);
      }

      .capabilities_card {
        width: 100%;
        position: relative;
        top: auto;
        left: auto;
        opacity: 1 !important;
        visibility: visible !important;
        transform: none !important;
      }
    }
  }
</style>
