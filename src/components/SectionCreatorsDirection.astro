      { x: 79.8, y: 16.3, scale: 0.41, opacity: 1 },
      { x: 68.9, y: 19.1, scale: 0.255, opacity: 0.35 },
      hidden(58, 22, 0.1),
      hidden(58, 22, 0.1),
      hidden(58, 22, 0.1),
    ],
    julia: [
      { x: 7, y: 51.5, scale: 0.58, opacity: 0 },
      { x: 15.8, y: 46.6, scale: 0.46, opacity: 1 },
      { x: 24.5, y: 41.8, scale: 0.34, opacity: 1 },
      { x: 33.3, y: 36.9, scale: 0.22, opacity: 0.35 },
