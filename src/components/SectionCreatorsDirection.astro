---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/Typography/Heading.astro";
import Img from "@/components/Media/Img.astro";
import darya from "@/assets/graphics/team-flying-photos/darya-new.png";
import dima from "@/assets/graphics/team-flying-photos/dima1-new.png";
import ivan from "@/assets/graphics/team-flying-photos/ivan-new.png";
import julia from "@/assets/graphics/team-flying-photos/julia-new.png";
import leshaOne from "@/assets/graphics/team-flying-photos/lesha1-new.png";
import leshaTwo from "@/assets/graphics/team-flying-photos/lesha2-new.png";
import maks from "@/assets/graphics/team-flying-photos/maks1-updated.png";
import nOne from "@/assets/graphics/team-flying-photos/n1-new.png";
import nTwo from "@/assets/graphics/team-flying-photos/n2-new.png";
import ruslan from "@/assets/graphics/team-flying-photos/ruslan-new.png";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true, class: className, ...rest } = Astro.props;

const photos = [
  { name: "lesha-one", label: "Alex", src: leshaOne, width: 653, height: 775 },
  { name: "maks", label: "Maks", src: maks, width: 688, height: 816 },
  { name: "julia", label: "Julia", src: julia, width: 688, height: 816 },
  { name: "dima", label: "Dima", src: dima, width: 688, height: 816 },
  { name: "lesha-two", label: "Alex", src: leshaTwo, width: 688, height: 816 },
  { name: "n-one", label: "Pavel", src: nOne, width: 688, height: 816 },
  { name: "ruslan", label: "Ruslan", src: ruslan, width: 688, height: 816 },
  { name: "ivan", label: "Ivan", src: ivan, width: 688, height: 816 },
  { name: "darya", label: "Darya", src: darya, width: 688, height: 816 },
  { name: "n-two", label: "Ilona", src: nTwo, width: 688, height: 816 },
];
---

{
  render && (
    <section
      class:list={["creators-direction_wrap theme-light", className]}
      aria-labelledby="creators-direction-title"
      data-creators-direction
      {...rest}
    >
      <div class="creators-direction_sticky">
        <div class="creators-direction_artboard">
          <div class="creators-direction_stage">
            <Heading
              id="creators-direction-title"
              tag="h2"
              variant="inherit"
              class="creators-direction_heading"
            >
              <span
                class="creators-direction_phrase creators-direction_phrase-ai"
                data-phrase="ai"
              >
                AI speeds the work
              </span>
              <span
                class="creators-direction_phrase creators-direction_phrase-creators"
                data-phrase="creators"
              >
                Creators lead it
              </span>
            </Heading>

            <div class="creators-direction_photos" aria-hidden="true">
              {photos.map((photo) => (
                <div
                  class:list={[
                    "creators-direction_photo",
                    `creators-direction_photo-${photo.name}`,
                  ]}
                  data-photo={photo.name}
                  data-cursor-label={photo.label}
                >
                  <Img
                    src={photo.src}
                    alt=""
                    width={photo.width}
                    height={photo.height}
                    transparent
                    loading="eager"
                    fetchPriority="low"
                  />
                </div>
              ))}
            </div>

            <span
              class="creators-direction_square"
              data-square
              aria-hidden="true"
            />
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { mountScrollScene } from "@/utils/motion/scrollScene";

  gsap.registerPlugin(ScrollTrigger);

